{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "http://109.120.135.24:8000/api/$1"
        },
        {
            "source": "/media/(.*)",
            "destination": "http://109.120.135.24:8000/media/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}